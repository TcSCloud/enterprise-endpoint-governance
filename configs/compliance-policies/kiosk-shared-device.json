{
  "metadata": {
    "name": "Windows 10/11 - Kiosk/Shared Device",
    "description": "Compliance for shared/kiosk devices",
    "author": "Taiwo Tee Awoniyi",
    "version": "1.1",
    "lastModified": "2026-03-07",
    "environment": "prod"
  },
  "policy": {
    "@odata.type": "#microsoft.graph.windows10CompliancePolicy",
    "displayName": "Windows 10/11 - Kiosk/Shared Device (v1.0)",
    "description": "Shared device compliance - Managed via GitHub",
    "passwordRequired": false,
    "passwordBlockSimple": true,
    "passwordRequiredToUnlockFromIdle": false,
    "passwordMinutesOfInactivityBeforeLock": 5,
    "passwordExpirationDays": null,
    "passwordMinimumLength": 6,
    "passwordMinimumCharacterSetCount": 1,
    "passwordRequiredType": "deviceDefault",
    "passwordPreviousPasswordBlockCount": 0,
    "requireHealthyDeviceReport": false,
    "osMinimumVersion": "10.0.19041",
    "storageRequireEncryption": false
  }
}