{
  "metadata": {
    "name": "Windows 10/11 - Secure Workstation",
    "description": "Enhanced security for PAW and admin devices",
    "author": "Taiwo Tee Awoniyi",
    "version": "1.3",
    "lastModified": "2026-03-08",
    "environment": "prod"
  },
  "policy": {
    "@odata.type": "#microsoft.graph.windows10CompliancePolicy",
    "displayName": "Windows 10/11 - Secure Workstation (v1.0)",
    "description": "High security compliance for privileged access - Managed via GitHub",
    "passwordRequired": true,
    "passwordBlockSimple": true,
    "passwordRequiredToUnlockFromIdle": true,
    "passwordMinutesOfInactivityBeforeLock": 240,
    "passwordExpirationDays": null,
    "passwordMinimumLength": 4,
    "passwordMinimumCharacterSetCount": 3,
    "passwordRequiredType": "deviceDefault",
    "passwordPreviousPasswordBlockCount": 5,
    "requireHealthyDeviceReport": false,
    "osMinimumVersion": "10.0.19041",
    "storageRequireEncryption": false
  }
}